print(d)
# a) A + B
print("ii) a) A + B:")
print(a + b) # Spowoduje błąd w R ze względu na niezgodność wymiarów
# b) A + B^T
print("ii) b) A + B^T:")
print(a + t(b))
# c) A %*% B (mnożenie macierzowe)
print("ii) c) A %*% B:")
print(a %*% b)
# d) A * A (mnożenie element-po-elemencie)
print("ii) d) A * A:")
print(a * a)
# e) D^-1 (macierz odwrotna do D)
print("ii) e) D^-1:")
print(solve(d))
# f) D %*% D^-1 (mnożenie macierzowe D * D^-1)
print("ii) f) D %*% D^-1:")
print(d %*% solve(d))
# a) cX = a  => X = c^-1 %*% a
print("iii) a) cX = a:")
print(solve(c) %*% a)
# b) Xd = a  => X = a %*% d^-1
print("iii) b) Xd = a:")
print(a %*% solve(d))
